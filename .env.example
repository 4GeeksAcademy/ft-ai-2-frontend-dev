# Brevity.app — copy to `.env` and adjust as needed.
# See memory-bank/decisions/0008-browser-vs-docker-urls.md

# --- Secrets / shared ---
JWT_SECRET=dev-secret-change-me

# --- PostgreSQL (used by brevity-api; Compose also sets this inline) ---
DB_URL=postgresql+psycopg://brevity:brevity@localhost:5432/brevity

# --- Browser / client bundles (localhost — host machine) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ANALYTICS_URL=http://localhost:8001

# --- Server-side only (Compose service DNS; not embedded in the browser) ---
API_URL=http://brevity-api:8000
ANALYTICS_URL=http://brevity-analytics:8001

# --- CORS (comma-separated; Swagger on :8000/:8001 needs these too) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8001,http://127.0.0.1:3000,http://127.0.0.1:8000,http://127.0.0.1:8001
# Optional regex (default allows any localhost / 127.0.0.1 port). Set empty to disable.
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?

# --- Observability (Session 4) ---
# Apps export OTLP HTTP to the collector. Leave unset to disable telemetry.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_BSP_SCHEDULE_DELAY=1000
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=64
OTEL_METRIC_EXPORT_INTERVAL=5000

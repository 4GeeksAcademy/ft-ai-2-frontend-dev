# Brevity.app — copy to `.env` and adjust as needed.
# See memory-bank/decisions/0008-browser-vs-docker-urls.md

# --- Secrets / shared ---
JWT_SECRET=dev-secret-change-me

# --- PostgreSQL (used by brevity-api; Compose also sets this inline) ---
DB_URL=postgresql+psycopg://brevity:brevity@localhost:5432/brevity

# --- Browser / client bundles (localhost — host machine) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ANALYTICS_URL=http://localhost:8001

# --- Server-side only (Compose service DNS; not embedded in the browser) ---
API_URL=http://brevity-api:8000
ANALYTICS_URL=http://brevity-analytics:8001

# --- CORS (comma-separated origins allowed by API services) ---
CORS_ORIGINS=http://localhost:3000
